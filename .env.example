# First runnable enterprise Docker slice.
# Reference values for shell environment overrides.

# Keep 127.0.0.1 for SSH tunnels/local-only testing.
# Use 0.0.0.0 or a specific private IP if you want browser/terminal access from your LAN/VPN.
# scripts/start_enterprise_stack.sh fills this automatically. Set it manually only when you run docker compose directly.
# HOST_PROJECT_ROOT=/absolute/path/to/honeypot
HOST_BIND_ADDRESS=127.0.0.1
CLIENT_TARGET_HOST=127.0.0.1
PUBLIC_PORTAL_PORT=8080
ENTRYPOINT_OBSERVER_PORT=8083
COWRIE_SSH_PORT=2222
INTERNAL_PORTAL_PORT=18080
GIT_INTERNAL_PORT=19418
OPS_DB_PORT=13306
REDIS_CACHE_PORT=16379
WEB_ADMIN_CONSOLE_PORT=18081
FTP_ARCHIVE_PORT=12121
SSH_CANARY_PORT=12222
LEGACY_TELNET_PORT=12323
DASHBOARD_PORT=8090
MAIL_RELAY_PORT=2525
FINANCE_SHARE_PORT=18082
ICS_PLC_PORT=18084
VPN_APPLIANCE_PORT=18443
MALWARE_SINK_PORT=18085
ASSET_GATEWAY_PORTS=18080,19418,13306,16379,18081,12121,12222,12323,2525,18082,18084,18443,18085
HONEYPOT_ASSET_GATEWAY_ENABLED=1
HONEYPOT_ENTRYPOINT_HTTP_SIGMA_RULES_PATH=data/detections/http_sigma
SNARE_HTTP_PORT=8081
SNARE_IMAGE=dtagdevsec/snare:24.04.1
TANNER_IMAGE=dtagdevsec/tanner:24.04.1
