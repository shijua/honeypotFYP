# First runnable enterprise Docker slice.
# Copy to .env if you want to override local ports.

# Keep 127.0.0.1 for SSH tunnels/local-only testing.
# Use 0.0.0.0 or a specific private IP if you want browser/terminal access from your LAN/VPN.
HOST_BIND_ADDRESS=127.0.0.1
CLIENT_TARGET_HOST=127.0.0.1
PUBLIC_PORTAL_PORT=8080
ENTRYPOINT_OBSERVER_PORT=8083
COWRIE_SSH_PORT=2222
INTERNAL_PORTAL_PORT=18080
DASHBOARD_PORT=8090
MAIL_RELAY_PORT=2525
SNARE_HTTP_PORT=8081
CHAMELEON_HTTP_PORT=8082
