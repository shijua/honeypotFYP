  {
    "asset_id": "admin-jumpbox",
    "asset_name": "Admin Jumpbox",
    "exposure_type": "internal",
    "interaction_level": "high",
    "description": "A Cowrie-backed SSH lure for observing credential reuse, shell commands, and lateral movement attempts.",
    "template_family": "ssh-honeypot",
    "protocols": ["ssh"],
    "ports": [22],
    "source_refs": ["tpotce:cowrie"],
    "default_settings": {
      "runtime": {
        "backend": "docker",
        "image": "ghcr.io/telekom-security/cowrie:24.04.1",
        "entrypoint": "/bin/sh",
        "command": [
          "-lc",
          "mkdir -p /tmp/cowrie /tmp/cowrie/data etc && exec /usr/bin/twistd --nodaemon -y cowrie.tac --pidfile /tmp/cowrie/cowrie.pid cowrie"
        ],
        "port_mappings": [
          {
            "host": "127.0.0.1",
            "requested_host_port": 2222,
            "container_port": 22
          }
        ],
        "healthcheck": {
          "type": "tcp",
          "host": "127.0.0.1",
          "port_setting": "host_port"
        },
        "source": "tpotce/docker/cowrie"
      },
      "hostname": "admin-jumpbox-01",
      "image_references": ["ghcr.io/telekom-security/cowrie:24.04.1"]
    },
    "covers_tactics": ["Lateral Movement", "Privilege Escalation"],
    "dependencies": ["git-internal"]
  },
